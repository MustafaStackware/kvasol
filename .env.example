# ---------------------------------------------------------------------------
# Enquiry form delivery. Set ONE of the two options below and rebuild.
# With neither set, submitting the form opens the visitor's email application
# pre-addressed to the company email in src/content/site.ts.
# ---------------------------------------------------------------------------

# Option A (recommended, free, no account): Web3Forms access key.
# Go to https://web3forms.com, enter info@kvasol.com, and the access key is
# emailed to that address. Submissions then arrive in the inbox directly.
NEXT_PUBLIC_WEB3FORMS_KEY=

# Option B: any endpoint that accepts a JSON POST of the form fields
# (Formspree, Google Apps Script, an SMTP relay, a serverless function).
# Takes priority over Option A when both are set.
NEXT_PUBLIC_ENQUIRY_ENDPOINT=

# NOTE: NEXT_PUBLIC_* values are inlined into the static bundle and are public.
# Only use keys designed for browser use — never a private API credential.
